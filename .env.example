# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only

# Security
ENCRYPTION_KEY=                     # 32 bytes, base64 (AES-256-GCM for stored secrets)
CRON_SECRET=                        # protects /api/jobs/tick and /api/pins/dispatch
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# LLM providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Stock images
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=                # feature flag OFF by default

# Pinterest
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REDIRECT_URI=

# Amazon Creators API (owner's own sites only)
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=

# Optional data providers (not needed for v1)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Billing (Phase 7)
BILLING_PROVIDER=
BILLING_WEBHOOK_SECRET=

# Analytics (optional)
GSC_SERVICE_ACCOUNT_JSON=
POSTHOG_KEY=
